      "source": [
        "n_nodes_ex12 = 50\n",
        "seed_ex12 = 42\n",
        "\n",
        "# 1. Generate four networks\n",
        "# Complete graph: every node is connected to every other node\n",
        "G_complete = nx.complete_graph(n_nodes_ex12)\n",
        "\n",
        "# Star graph: one central node connected to all others, no other connections\n",
        "G_star = nx.star_graph(n_nodes_ex12 - 1) # n_nodes_ex12-1 because one node is central\n",
        "\n",
        "# Cycle graph: nodes form a closed loop\n",
        "G_cycle = nx.cycle_graph(n_nodes_ex12)\n",
        "\n",
        "# Watts-Strogatz small-world graph\n",
        "G_ws_ex12 = nx.watts_strogatz_graph(n_nodes_ex12, k=6, p=0.3, seed=seed_ex12)\n",
        "\n",
        "networks_ex12 = {\n",
        "    \"Complete Graph\": G_complete,\n",
        "    \"Star Graph\": G_star,\n",
        "    \"Cycle Graph\": G_cycle,\n",
        "    \"Watts-Strogatz\": G_ws_ex12,\n",
        "}\n",
        "\n",
        "metrics_ex12 = []\n",
        "\n",
        "# 2. Compute average clustering and transitivity for each\n",
        "for name, G in networks_ex12.items():\n",
        "    avg_clustering = nx.average_clustering(G)\n",
        "    transitivity = nx.transitivity(G)\n",
        "\n",
        "    metrics_ex12.append({\n",
        "        \"Network Type\": name,\n",
        "        \"Average Clustering\": round(avg_clustering, 4),\n",

        "# Prepare discrete colors for communities using a colormap\n",
        "community_hex_colors = [mcolors.to_hex(community_colors_map(i)) for i in range(n_comms)]\n",
        "\n",
        "# Add nodes with attributes and hover tooltips\n",
        "for node in G_pipeline.nodes():\n",
        "    node_data = G_pipeline.nodes[node]\n",
        "\n",
        "    color = community_hex_colors[node_data['community']]\n",
        "    size = node_data['degree'] * 2 + 10 # Scale for Pyvis visibility\n",
        "\n",
        "    title_html = f\"<b>Node:</b> {node}<br>\" \\\n",
        "                 f\"<b>Community:</b> {node_data['community']}<br>\" \\\n",
        "                 f\"<b>Degree:</b> {node_data['degree']}<br>\" \\\n",
        "                 f\"<b>Betweenness:</b> {node_data['betweenness']:.4f}<br>\" \\\n",
        "                 f\"<b>Closeness:</b> {node_data['closeness']:.4f}<br>\" \\\n",
        "                 f\"<b>Clustering:</b> {node_data['clustering']:.4f}\"\n",
        "\n",
        "    net.add_node(str(node), label=str(node), color=color, size=size, title=title_html)\n",
        "\n",
        "# Add edges\n",
        "for u, v in G_pipeline.edges():\n",
        "    net.add_edge(str(u), str(v), color=\"#B7A6D5\", width=0.5)\n",

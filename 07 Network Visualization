      "source": [
        "import networkx as nx\n",
        "import plotly.graph_objects as go\n",
        "from community import community_louvain\n",
        "from collections import Counter\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Load the Les Miserables graph\n",
        "G_les = nx.les_miserables_graph()\n",
        "\n",
        "print(f\"Les Miserables Network: {G_les.number_of_nodes()} nodes, {G_les.number_of_edges()} edges\")\n",
        "\n",
        "# 2. Detect communities using Louvain\n",
        "partition = community_louvain.best_partition(G_les, random_state=42)\n",
        "n_comms = len(set(partition.values()))\n",
        "nx.set_node_attributes(G_les, partition, 'community') # Store community as node attribute\n",
        "\n",
        "print(f\"Detected {n_comms} communities using Louvain algorithm.\")\n",
        "\n",
        "# 3. Compute all five key metrics\n",
        "degrees = dict(G_les.degree())\n",
        "betweenness = nx.betweenness_centrality(G_les)\n",
        "closeness = nx.closeness_centrality(G_les)\n",
        "clustering = nx.clustering(G_les)\n",
        "density = nx.density(G_les)\n",
        "\n",
        "# Store metrics as node attributes for easy access in hover info\n",
        "nx.set_node_attributes(G_les, degrees, 'degree')\n",
        "nx.set_node_attributes(G_les, betweenness, 'betweenness')\n",
        "nx.set_node_attributes(G_les, closeness, 'closeness')\n",
        "nx.set_node_attributes(G_les, clustering, 'clustering')\n",
        "\n",
        "print(f\"Network Density: {density:.4f}\")\n",
        "print(f\"Average Clustering Coefficient: {nx.average_clustering(G_les):.4f}\")\n",
        "\n",
        "# 4. For each community, identify the most central character (by betweenness centrality)\n",
        "community_leaders = {}\n",
        "for comm_id in set(partition.values()):\n",
        "    community_nodes = [node for node, comm in partition.items() if comm == comm_id]\n",
        "    if community_nodes:\n",
        "        # Find the node with the highest betweenness within this community\n",
        "        leader = max(community_nodes, key=lambda node: betweenness[node])\n",
        "        community_leaders[comm_id] = {'node': leader, 'betweenness': betweenness[leader]}\n",
        "\n",
        "print(\"\\nMost central character (by betweenness) in each community:\")\n",
        "for comm_id, data in sorted(community_leaders.items()):\n",
        "    print(f\"  Community {comm_id}: {data['node']} (Betweenness: {data['betweenness']:.4f})\")\n",
        "\n",
        "# Prepare data for Plotly visualization\n",
        "pos = nx.spring_layout(G_les, seed=42) # Layout for visualization\n",
        "\n",
        "# Edge traces\n",
        "edge_x = []\n",
        "edge_y = []\n",
        "for edge in G_les.edges():\n",
        "    x0, y0 = pos[edge[0]]\n",
        "    x1, y1 = pos[edge[1]]\n",
        "    edge_x.extend([x0, x1, None])\n",
        "    edge_y.extend([y0, y1, None])\n",
        "\n",
        "edge_trace = go.Scatter(\n",
        "    x=edge_x,\n",
        "    y=edge_y,\n",
        "    line=dict(width=0.5, color='#888'),\n",
        "    hoverinfo='none',\n",
        "    mode='lines')\n",
        "\n",
        "# Node traces\n",
        "node_x = []\n",
        "node_y = []\n",
        "node_labels = []\n",
        "node_colors = []\n",
        "node_sizes = []\n",
        "node_hover_text = []\n",
        "\n",
        "for node in G_les.nodes():\n",
        "    x, y = pos[node]\n",
        "    node_x.append(x)\n",
        "    node_y.append(y)\n",
        "    node_labels.append(node)\n",
        "\n",
        "    # Color by community\n",
        "    node_colors.append(G_les.nodes[node]['community'])\n",
        "\n",
        "    # Size by degree (scaled for better visibility)\n",
        "    size = G_les.nodes[node]['degree'] * 2 + 5 # Base size + degree scaled\n",
        "    node_sizes.append(size)\n",
        "\n",
        "    # Hover text with all attributes\n",
        "    hover_info = f\"<b>Character:</b> {node}<br>\" \\\n",
        "                 f\"<b>Community:</b> {G_les.nodes[node]['community']}<br>\" \\\n",
        "                 f\"<b>Degree:</b> {G_les.nodes[node]['degree']}<br>\" \\\n",
        "                 f\"<b>Betweenness:</b> {G_les.nodes[node]['betweenness']:.4f}<br>\" \\\n",
        "                 f\"<b>Closeness:</b> {G_les.nodes[node]['closeness']:.4f}<br>\" \\\n",
        "                 f\"<b>Clustering:</b> {G_les.nodes[node]['clustering']:.4f}\"\n",
        "    node_hover_text.append(hover_info)\n",
        "\n",
        "node_trace = go.Scatter(\n",
        "    x=node_x,\n",
        "    y=node_y,\n",
        "    mode='markers',\n",
        "    hoverinfo='text',\n",
        "    text=node_labels, # Show labels on hover if not displayed directly\n",
        "    hovertext=node_hover_text,\n",
        "    marker=dict(\n",
        "        showscale=True,\n",
        "        colorscale='Viridis', # Use a distinct color scale for communities\n",
        "        reversescale=False,\n",
        "        color=node_colors,\n",
        "        size=node_sizes,\n",
        "        line_width=1, # Node border\n",
        "        line_color='white'\n",
        "    ),\n",
        "    name='Nodes'\n",
        ")\n",
        "\n",
        "# Create the Plotly figure\n",
        "fig = go.Figure(data=[edge_trace, node_trace],\n",
        "             layout=go.Layout(\n",
        "                title='<br>Les Miserables Character Network: Communities and Centrality',\n",
        "                titlefont_size=16,\n",
        "                showlegend=False,\n",
        "                hovermode='closest',\n",
        "                margin=dict(b=20,l=5,r=5,t=40),\n",
        "                annotations=[ dict(\n",
        "                    text=\"Interactive visualization of Les Miserables network.\\nNode size indicates Degree, color indicates Community.\\nHover for detailed metrics.\",\n",
        "                    showarrow=False,\n",
        "                    xref=\"paper\", yref=\"paper\",\n",
        "                    x=0.005, y=-0.002 ) ],\n",
        "                xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
        "                yaxis=dict(showgrid=False, zeroline=False, showticklabels=False))\n",
        "                )\n",
        "\n",
        "fig.show()\n",
        "\n",
        "# 5. Identify bridge characters (high betweenness + connections to multiple communities)\n",
        "# We'll identify characters with high betweenness and inspect their community affiliations.\n",
        "# Sort all nodes by betweenness centrality in descending order\n",
        "sorted_by_betweenness = sorted(betweenness.items(), key=lambda item: item[1], reverse=True)\n",
        "\n",
        "print(\"\\nPotential Bridge Characters (sorted by Betweenness Centrality):\")\n",
        "bridge_candidates_list = []\n",
        "\n",
        "# Consider top characters by betweenness and check their connections to other communities\n",
        "for char, bc_score in sorted_by_betweenness[:10]: # Look at top 10 for discussion\n",
        "    node_community = partition[char]\n",
        "    neighbor_communities = set()\n",
        "    for neighbor in G_les.neighbors(char):\n",
        "        neighbor_communities.add(partition[neighbor])\n",
        "\n",
        "    # A node is a bridge if it connects to more than one community\n",
        "    if len(neighbor_communities) > 1:\n",
        "        bridge_candidates_list.append({\n",
        "            'character': char,\n",
        "            'betweenness': bc_score,\n",
        "            'community': node_community,\n",
        "            'connected_communities': list(neighbor_communities)\n",
        "        })\n",
        "        print(f\"  - {char}: BC={bc_score:.4f}, Community={node_community}, Neighbors in communities: {list(neighbor_communities)}\")\n",
        "\n",
        "if not bridge_candidates_list:\n",
        "    print(\"No explicit bridge characters found based on connecting to multiple *neighboring* communities.\")\n",
        "\n",
        "\n",
        "\n",
        "\n"
      ],

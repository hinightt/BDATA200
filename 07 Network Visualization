        "for i in range(len(A_emails)):\n",
        "    for j in range(len(A_emails)):\n",
        "        text_color = \"white\" if A_emails.values[i, j] > 0 else \"gray\"\n",
        "        axes[0].text(j, i, str(A_emails.values[i, j]), ha=\"center\", va=\"center\", color=text_color, fontweight=\"bold\")\n",
        "\n",
        "axes[0].set_title(\"Email Adjacency Matrix (Weighted Heatmap)\", fontweight=\"bold\", color=\"#4B2E83\")\n",
        "plt.colorbar(im, ax=axes[0], shrink=0.8, label=\"Number of Emails Sent\")\n",
        "\n",
        "# Plot 2: Network Visualization\n",
        "pos = nx.spring_layout(G_emails, seed=42)\n",
        "\n",
        "edges = G_emails.edges(data=True)\n",
        "weights = [d[\"weight\"] * 0.3 for _, _, d in edges] # Scale weights for visualization\n",
        "\n",
        "nx.draw(G_emails, pos, ax=axes[1], with_labels=True,\n",
        "        node_color=\"#4B2E83\", font_color=\"#E8B923\", font_weight=\"bold\",\n",
        "        node_size=1000, edge_color=\"#B7A6D5\", width=weights,\n",

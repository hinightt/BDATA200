        "    (\"Emily\", \"Anna\", 50), (\"Emily\", \"Frank\", 12),\n",
        "    (\"Frank\", \"Clara\", 18)\n",
        "]\n",
        "\n",
        "for caller, receiver, duration in call_data:\n",
        "    G_calls.add_edge(caller, receiver, weight=duration)\n",
        "\n",
        "# Display the weighted adjacency matrix as a heatmap\n",
        "A_calls = nx.to_pandas_adjacency(G_calls, weight=\"weight\", dtype=int)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(18, 7))\n",
        "\n",
        "# Plot 1: Adjacency Matrix Heatmap\n",
        "im = axes[0].imshow(A_calls.values, cmap=\"Purples\", aspect=\"equal\")\n",
        "axes[0].set_xticks(range(len(A_calls))); axes[0].set_xticklabels(A_calls.columns, rotation=45, ha=\"right\")\n",
        "axes[0].set_yticks(range(len(A_calls))); axes[0].set_yticklabels(A_calls.index)\n",
        "\n",
        "# Add values to the heatmap cells\n",
        "for i in range(len(A_calls)):\n",
        "    for j in range(len(A_calls)):\n",
        "        text_color = \"white\" if A_calls.values[i, j] > 0 else \"gray\"\n",
        "        axes[0].text(j, i, str(A_calls.values[i, j]), ha=\"center\", va=\"center\", color=text_color, fontweight=\"bold\")\n",
        "\n",
        "axes[0].set_title(\"Phone Call Adjacency Matrix (Weighted Heatmap)\", fontweight=\"bold\", color=\"#4B2E83\")\n",
        "plt.colorbar(im, ax=axes[0], shrink=0.8, label=\"Call Duration (minutes)\")\n",
        "\n",
        "# Plot 2: Network Visualization\n",
        "pos = nx.spring_layout(G_calls, seed=42)\n",

        "# Compute total call duration sent (out-weight) and received (in-weight)\n",
        "out_durations = {node: G_calls.out_degree(node, weight='weight') for node in G_calls.nodes()}\n",
        "in_durations = {node: G_calls.in_degree(node, weight='weight') for node in G_calls.nodes()}\n",

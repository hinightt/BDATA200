      "source": [
        "G_emails = nx.DiGraph()\n",
        "employees = [\"Alice\", \"Bob\", \"Carol\", \"Dave\", \"Eve\", \"Frank\"]\n",
        "G_emails.add_nodes_from(employees)\n",
        "\n",
        "# Define email transactions with weights (number of emails)\n",
        "email_transactions = [\n",
        "    (\"Alice\", \"Bob\", 12), (\"Alice\", \"Carol\", 8), (\"Alice\", \"Dave\", 5),\n",
        "    (\"Bob\", \"Carol\", 15), (\"Bob\", \"Eve\", 7),\n",
        "    (\"Carol\", \"Alice\", 3), (\"Carol\", \"Dave\", 10),\n",
        "    (\"Dave\", \"Bob\", 6), (\"Dave\", \"Frank\", 9),\n",
        "    (\"Eve\", \"Alice\", 11), (\"Eve\", \"Frank\", 4),\n",
        "    (\"Frank\", \"Carol\", 2)\n",
        "]\n",
        "\n",
        "for sender, receiver, count in email_transactions:\n",
        "    G_emails.add_edge(sender, receiver, weight=count)\n",
        "\n",
        "# Display the weighted adjacency matrix\n",
        "A_emails = nx.to_pandas_adjacency(G_emails, weight=\"weight\", dtype=int)\n",
        "\n",
        "print(\"Weighted Adjacency Matrix:\")\n",
        "print(A_emails)\n",
        "\n",
        "# Compute in-degree (received emails) and out-degree (sent emails)\n",
        "out_degrees = dict(G_emails.out_degree(weight='weight'))\n",
        "in_degrees = dict(G_emails.in_degree(weight='weight'))\n",
        "\n",
        "most_sent = max(out_degrees, key=out_degrees.get)\n",
        "most_received = max(in_degrees, key=in_degrees.get)\n",
        "\n",
        "print(f\"\\nEmployee who sends the most emails: {most_sent} ({out_degrees[most_sent]} emails)\")\n",
        "print(f\"Employee who receives the most emails: {most_received} ({in_degrees[most_received]} emails)\")\n",
        "\n",
        "# Visualize the network and the heatmap side by side\n",
        "fig, axes = plt.subplots(1, 2, figsize=(18, 7)) # Adjust figsize for two plots\n",
        "\n",
        "# Plot 1: Adjacency Matrix Heatmap\n",
        "im = axes[0].imshow(A_emails.values, cmap=\"Purples\", aspect=\"equal\")\n",

        "<div style=\"background: linear-gradient(135deg, #4B2E83 0%, #32006E 100%); padding: 30px; border-radius: 10px; margin: 40px 0 30px 0; box-shadow: 0 5px 15px rgba(75,46,131,0.2);\">\n",

      "source": [
        "import networkx as nx\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "n_nodes = 20\n",
        "seed = 42\n",
        "\n",
        "# 1. Generate three networks\n",
        "# a) Erdos-Renyi random graph\n",
        "G_er = nx.erdos_renyi_graph(n_nodes, p=0.15, seed=seed)\n",
        "\n",
        "# b) Barabasi-Albert preferential attachment graph\n",
        "G_ba = nx.barabasi_albert_graph(n_nodes, m=2, seed=seed)\n",
        "\n",
        "# c) Watts-Strogatz small-world graph\n",
        "G_ws = nx.watts_strogatz_graph(n_nodes, k=4, p=0.3, seed=seed)\n",
        "\n",
        "networks = {\n",
        "    \"Erdos-Renyi\": G_er,\n",
        "    \"Barabasi-Albert\": G_ba,\n",
        "    \"Watts-Strogatz\": G_ws,\n",
        "}\n",
        "\n",
        "metrics = []\n",
        "\n",
        "# 2. Compute density, average clustering, and average shortest path length for each\n",
        "for name, G in networks.items():\n",
        "    density = nx.density(G)\n",
        "    avg_clustering = nx.average_clustering(G)\n",
        "\n",
        "    # Average shortest path length is only defined for connected graphs.\n",
        "    # We'll calculate it for the largest connected component if the graph is disconnected.\n",
        "    if nx.is_connected(G):\n",
        "        avg_shortest_path_length = nx.average_shortest_path_length(G)\n",
        "    else:\n",
        "        # Find the largest connected component\n",
        "        largest_cc = G.subgraph(max(nx.connected_components(G), key=len))\n",
        "        if nx.is_connected(largest_cc) and len(largest_cc) > 1: # Ensure it's still connected and has more than one node\n",
        "            avg_shortest_path_length = nx.average_shortest_path_length(largest_cc)\n",
        "            print(f\"Warning: {name} is disconnected. Computed ASP on largest component of size {len(largest_cc)}.\")\n",
        "        else:\n",
        "            avg_shortest_path_length = float('nan') # Not well-defined for isolated nodes or single-node components\n",
        "            print(f\"Warning: {name} is severely disconnected. ASP could not be reliably computed.\")\n",
        "\n",
        "    metrics.append({\n",
        "        \"Network Type\": name,\n",
        "        \"Density\": round(density, 4),\n",
        "        \"Average Clustering\": round(avg_clustering, 4),\n",
        "        \"Average Shortest Path Length\": round(avg_shortest_path_length, 4)\n",
        "    })\n",
        "\n",
        "metrics_df = pd.DataFrame(metrics)\n",
        "print(\"Network Metrics Comparison:\")\n",
        "display(metrics_df)\n"
      ],

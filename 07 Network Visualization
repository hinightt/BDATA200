        "edges = G_calls.edges(data=True)\n",
        "widths = [d[\"weight\"] * 0.05 for _, _, d in edges] # Scale weights for visualization\n",
        "\n",
        "nx.draw(G_calls, pos, ax=axes[1], with_labels=True,\n",
        "        node_color=\"#4B2E83\", font_color=\"#E8B923\", font_weight=\"bold\",\n",
        "        node_size=1200, edge_color=\"#B7A6D5\", width=widths,\n",
        "        arrows=True, arrowsize=15, connectionstyle=\"arc3,rad=0.1\")\n",
        "\n",
        "edge_labels = {(u, v): d[\"weight\"] for u, v, d in G_calls.edges(data=True)}\n",
        "nx.draw_networkx_edge_labels(G_calls, pos, edge_labels, font_size=8, font_color=\"#333\", ax=axes[1])\n",
        "\n",
        "axes[1].set_title(\"Employee Phone Call Network\", fontweight=\"bold\", color=\"#4B2E83\")\n",
        "plt.tight_layout()\n",

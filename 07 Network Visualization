        "call_data = [\n",
        "    (\"Anna\", \"Ben\", 30), (\"Anna\", \"Clara\", 15), (\"Anna\", \"David\", 20),\n",
        "    (\"Ben\", \"Anna\", 10), (\"Ben\", \"Emily\", 45),\n",

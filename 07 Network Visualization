        "import networkx as nx\n",
        "import matplotlib.pyplot as plt\n",
        "from community import community_louvain\n",
        "from collections import Counter\n",
        "import pandas as pd\n",
        "from pyvis.network import Network\n",
        "import matplotlib.colors as mcolors\n",
        "\n",
        "# 1. Create/Load a network with at least 50 nodes (using powerlaw_cluster_graph)\n",
        "n_nodes = 100\n",
        "m_edges = 3\n",
        "p_triangle = 0.05 # Probability of adding a triangle\n",
        "seed = 42\n",
        "G_pipeline = nx.powerlaw_cluster_graph(n_nodes, m_edges, p_triangle, seed=seed)\n",
        "\n",
        "print(f\"Loaded Network: {G_pipeline.number_of_nodes()} nodes, {G_pipeline.number_of_edges()} edges\")\n",
        "\n",
        "# 2. Compute all five metrics\n",
        "degrees = dict(G_pipeline.degree())\n",
        "betweenness = nx.betweenness_centrality(G_pipeline)\n",
        "closeness = nx.closeness_centrality(G_pipeline)\n",
        "clustering = nx.clustering(G_pipeline)\n",
        "density = nx.density(G_pipeline)\n",
        "\n",
        "# Store metrics as node attributes for easy access in visualizations/hover info\n",
        "nx.set_node_attributes(G_pipeline, degrees, 'degree')\n",
        "nx.set_node_attributes(G_pipeline, betweenness, 'betweenness')\n",
        "nx.set_node_attributes(G_pipeline, closeness, 'closeness')\n",
        "nx.set_node_attributes(G_pipeline, clustering, 'clustering')\n",
        "\n",
        "print(f\"Network Density: {density:.4f}\")\n",
        "print(f\"Average Clustering Coefficient: {nx.average_clustering(G_pipeline):.4f}\")\n",
        "\n",
        "# 3. Detect communities using Louvain\n",
        "partition = community_louvain.best_partition(G_pipeline, random_state=seed)\n",
        "n_comms = len(set(partition.values()))\n",
        "nx.set_node_attributes(G_pipeline, partition, 'community') # Store community as node attribute\n",
        "\n",
        "print(f\"Detected {n_comms} communities using Louvain algorithm.\")\n",
        "\n",
        "# 4. Find connected components\n",
        "components = list(nx.connected_components(G_pipeline))\n",
        "largest_component = max(components, key=len)\n",
        "\n",
        "print(f\"Number of connected components: {len(components)}\")\n",
        "print(f\"Size of largest component: {len(largest_component)} out of {n_nodes} nodes\")\n",
        "\n",
        "# Create a DataFrame for summary\n",
        "metrics_df_pipeline = pd.DataFrame({\n",
        "    \"Degree\": degrees,\n",
        "    \"Betweenness\": betweenness,\n",
        "    \"Closeness\": closeness,\n",
        "    \"Clustering\": clustering,\n",
        "    \"Community\": partition\n",
        "}).round(4)\n",
        "\n",
        "print(\"\\nTop 5 nodes by Degree:\")\n",
        "display(metrics_df_pipeline.nlargest(5, 'Degree'))"

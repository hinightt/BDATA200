      "source": [
        "import networkx as nx\n",
        "from pyvis.network import Network\n",
        "from community import community_louvain\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.colors as mcolors\n",
        "\n",
        "# 1. Build a directed network representing organizational information flow\n",
        "G_org = nx.DiGraph()\n",
        "\n",
        "# Define nodes (employees/roles) and their types\n",
        "individuals_data = {\n",
        "    \"CEO\": \"Leadership\",\n",
        "    \"CTO\": \"Leadership\",\n",
        "    \"Head_Sales\": \"Sales\",\n",
        "    \"Sales_Rep_A\": \"Sales\",\n",
        "    \"Sales_Rep_B\": \"Sales\",\n",
        "    \"Head_Eng\": \"Engineering\",\n",
        "    \"Engineer_X\": \"Engineering\",\n",
        "    \"Engineer_Y\": \"Engineering\",\n",
        "    \"Head_Mkt\": \"Marketing\",\n",
        "    \"Mkt_Specialist\": \"Marketing\",\n",
        "    \"HR_Manager\": \"HR\",\n",
        "    \"HR_Specialist\": \"HR\",\n",
        "    \"Legal_Counsel\": \"Legal\",\n",
        "    \"Project_Lead_A\": \"Project\",\n",
        "    \"Project_Lead_B\": \"Project\",\n",
        "    \"Intern\": \"Project\",\n",
        "    \"Admin_Assistant\": \"Support\",\n",
        "    \"Analyst_Finance\": \"Finance\",\n",
        "    \"Designer_UX\": \"Engineering\",\n",
        "    \"Product_Manager\": \"Leadership\",\n",
        "    \"QA_Tester\": \"Engineering\",\n",
        "    \"Recruiter\": \"HR\"\n",
        "}\n",
        "\n",
        "G_org.add_nodes_from(individuals_data.keys())\n",
        "\n",
        "# Define information flow (edges with weights representing frequency/importance)\n",
        "# Ensure at least 20 nodes and diverse connections\n",
        "info_flows = [\n",
        "    (\"CEO\", \"CTO\", 5), (\"CEO\", \"Head_Sales\", 4), (\"CEO\", \"Head_Eng\", 4), (\"CEO\", \"HR_Manager\", 3),\n",
        "    (\"CTO\", \"Head_Eng\", 6), (\"CTO\", \"Project_Lead_A\", 4), (\"CTO\", \"QA_Tester\", 2),\n",
        "    (\"Head_Sales\", \"Sales_Rep_A\", 7), (\"Head_Sales\", \"Sales_Rep_B\", 7), (\"Head_Sales\", \"Head_Mkt\", 3),\n",
        "    (\"Sales_Rep_A\", \"Engineer_X\", 2), (\"Sales_Rep_B\", \"Mkt_Specialist\", 3),\n",
        "    (\"Head_Eng\", \"Engineer_X\", 8), (\"Head_Eng\", \"Engineer_Y\", 8), (\"Head_Eng\", \"Project_Lead_A\", 5), (\"Head_Eng\", \"Designer_UX\", 6),\n",
        "    (\"Engineer_X\", \"Engineer_Y\", 5), (\"Engineer_Y\", \"Project_Lead_B\", 4), (\"Engineer_X\", \"QA_Tester\", 3),\n",
        "    (\"Head_Mkt\", \"Mkt_Specialist\", 9), (\"Head_Mkt\", \"CEO\", 2), (\"Head_Mkt\", \"Designer_UX\", 3),\n",
        "    (\"Mkt_Specialist\", \"Sales_Rep_A\", 1), (\"Mkt_Specialist\", \"Project_Lead_A\", 2),\n",
        "    (\"HR_Manager\", \"Recruiter\", 7), (\"HR_Manager\", \"Admin_Assistant\", 5), (\"HR_Manager\", \"Legal_Counsel\", 4),\n",
        "    (\"Recruiter\", \"Intern\", 3),\n",
        "    (\"Admin_Assistant\", \"HR_Manager\", 2), (\"Admin_Assistant\", \"CEO\", 1),\n",
        "    (\"Legal_Counsel\", \"CEO\", 2), (\"Legal_Counsel\", \"HR_Manager\", 3),\n",
        "    (\"Project_Lead_A\", \"Engineer_X\", 5), (\"Project_Lead_A\", \"Intern\", 4), (\"Project_Lead_A\", \"Product_Manager\", 6),\n",
        "    (\"Project_Lead_B\", \"Engineer_Y\", 3), (\"Project_Lead_B\", \"Product_Manager\", 5),\n",
        "    (\"Intern\", \"Project_Lead_A\", 1),\n",
        "    (\"Analyst_Finance\", \"CEO\", 3), (\"Analyst_Finance\", \"HR_Manager\", 1), (\"Analyst_Finance\", \"Head_Sales\", 2),\n",
        "    (\"Product_Manager\", \"Head_Eng\", 4), (\"Product_Manager\", \"Head_Mkt\", 4), (\"Product_Manager\", \"Engineer_X\", 3),\n",
        "    (\"QA_Tester\", \"Engineer_Y\", 2)\n",
        "]\n",
        "\n",
        "for src, tgt, weight in info_flows:\n",
        "    G_org.add_edge(src, tgt, weight=weight)\n",
        "\n",
        "print(f\"Organizational Network created with {G_org.number_of_nodes()} nodes and {G_org.number_of_edges()} edges.\")\n",
        "\n",
        "# Add 'type' attribute to nodes\n",
        "nx.set_node_attributes(G_org, individuals_data, \"type\")\n",
        "\n",
        "# Compute node importance (using weighted out-degree as a proxy for information dissemination)\n",
        "# Also compute in-degree for hover info\n",
        "out_degrees = dict(G_org.out_degree(weight='weight'))\n",
        "in_degrees = dict(G_org.in_degree(weight='weight'))\n",
        "nx.set_node_attributes(G_org, out_degrees, \"importance_out\")\n",
        "nx.set_node_attributes(G_org, in_degrees, \"importance_in\")\n",
        "\n",
        "# Detect communities (groups) using Louvain algorithm on the undirected version\n",
        "# as community_louvain.best_partition works best on undirected graphs\n",
        "undirected_G_org = G_org.to_undirected()\n",
        "communities = community_louvain.best_partition(undirected_G_org, random_state=42)\n",
        "nx.set_node_attributes(G_org, communities, \"community_group\")\n",
        "\n",
        "# Prepare color mapping for communities\n",
        "unique_communities = sorted(list(set(communities.values())))\n",
        "# Use a colormap for distinct colors\n",
        "colors = plt.cm.get_cmap('tab20', len(unique_communities))\n",
        "community_color_map = {comm_id: mcolors.to_hex(colors(i)) for i, comm_id in enumerate(unique_communities)}\n",
        "\n",
        "\n",
        "# 3. Create an interactive Pyvis visualization\n",
        "net = Network(notebook=True, height=\"700px\", width=\"100%\", bgcolor=\"#F9F7FC\",\n",
        "              cdn_resources=\"in_line\", directed=True)\n",
        "\n",
        "# Add nodes with attributes\n",
        "for node in G_org.nodes():\n",
        "    node_data = G_org.nodes[node]\n",
        "    node_type = node_data.get(\"type\", \"N/A\")\n",
        "    node_importance_out = node_data.get(\"importance_out\", 0)\n",
        "    node_importance_in = node_data.get(\"importance_in\", 0)\n",
        "    node_group = node_data.get(\"community_group\", \"N/A\")\n",
        "\n",
        "    # Node color by group (community)\n",
        "    color = community_color_map.get(node_group, \"#888888\") # Default to gray if group not found\n",
        "\n",
        "    # Node size by importance (weighted out-degree), scaled for visibility\n",
        "    size = 10 + node_importance_out * 0.5  # Adjust scaling factor as needed\n",
        "    size = max(15, size) # Ensure a minimum size\n",
        "\n",
        "    # Hover tooltip showing all attributes\n",
        "    title_html = f\"<b>{node}</b><br>\"\n",
        "    title_html += f\"Role: {node_type}<br>\"\n",
        "    title_html += f\"Info Sent (weighted out-degree): {node_importance_out}<br>\"\n",
        "    title_html += f\"Info Received (weighted in-degree): {node_importance_in}<br>\"\n",
        "    title_html += f\"Community Group: {node_group}\"\n",
        "\n",
        "    net.add_node(str(node), label=str(node), color=color, size=size,\n",
        "                 title=title_html)\n",
        "\n",
        "# Add edges with weights and arrows\n",
        "for u, v, d in G_org.edges(data=True):\n",
        "    edge_weight = d.get(\"weight\", 1)\n",
        "    net.add_edge(str(u), str(v), value=edge_weight, title=f\"Flow: {edge_weight}\",\n",
        "                 arrows='to', arrowStrikethrough=False, width=edge_weight*0.1, color=\"#B7A6D5\")\n",
        "\n",
        "# Enable physics simulation for dynamic layout\n",
        "net.toggle_physics(True)\n",
        "\n",
        "# 4. Export to HTML\n",
        "output_filename = \"organizational_information_flow.html\"\n",
        "net.show(output_filename)\n",
        "\n",
        "print(f\"Interactive visualization saved to {output_filename}\")\n",
        "print(\"Open the file in a browser to explore the network interactively!\")"
      ],

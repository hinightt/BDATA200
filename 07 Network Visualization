        "<div style=\"background-color: #FFF3E0; border-left: 4px solid #F57C00; padding: 15px 20px; margin: 20px 0; border-radius: 5px;\">\n",
        "  <h3 style=\"color: #F57C00; margin-top: 0;\">Exercise 2 &mdash; Model an Email Communication Network</h3>\n",

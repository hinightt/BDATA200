        "def prepare_dashboard_data_for_year(year, races_df, pit_stops_all, lap_driver_all, race_result_all, drivers_df):\n",
        "    \"\"\"\n",
        "    Prepares a DataFrame for dashboard visualization for a given year.\n",
        "    Handles cases where pit_stops_all might be None.\n",
        "    \"\"\"\n",
        "    races_in_year = races_df[races_df['year'] == year].copy()\n",
        "    if races_in_year.empty:\n",
        "        return pd.DataFrame() # Return empty DataFrame if no races for the year\n",
        "\n",
        "    race_ids_in_year = races_in_year['raceId'].tolist()\n",
        "\n",
        "    # Handle pit_stops_all being None gracefully\n",
        "    if pit_stops_all is not None and not pit_stops_all.empty:\n",
        "        pit_stops_year = pit_stops_all[pit_stops_all['raceId'].isin(race_ids_in_year)].copy()\n",
        "    else:\n",
        "        pit_stops_year = pd.DataFrame() # Use an empty DataFrame if no pit stop data\n",
        "\n",
        "    lap_driver_year = lap_driver_all[lap_driver_all['raceId'].isin(race_ids_in_year)].copy()\n",
        "    race_result_year = race_result_all[race_result_all['raceId'].isin(race_ids_in_year)].copy()\n",
        "\n",
        "    # Merge race results with driver data\n",
        "    df_year = pd.merge(race_result_year, drivers_df[['driverId', 'forename', 'surname']], on='driverId', how='left')\n",
        "\n",
        "    # Calculate average start and final positions\n",
        "    df_year['grid'] = pd.to_numeric(df_year['grid'], errors='coerce')\n",
        "    df_year['position'] = pd.to_numeric(df_year['position'], errors='coerce')\n",
        "\n",
        "    # Filter out NaNs for position calculation to avoid issues with mean\n",
        "    df_year_filtered = df_year.dropna(subset=['grid', 'position'])\n",
        "\n",
        "    if df_year_filtered.empty:\n",
        "        return pd.DataFrame() # Return empty DataFrame if no valid race performance data\n",
        "\n",
        "    driver_race_performance_year = df_year_filtered.groupby('driverId').agg(\n",
        "        avg_start_position=('grid', 'mean'),\n",
        "        avg_final_position=('position', 'mean')\n",
        "    ).reset_index()\n",
        "\n",
        "    # Merge with driver names and create short surname for plotting\n",
        "    driver_race_performance_year = pd.merge(\n",
        "        driver_race_performance_year,\n",
        "        drivers_df[['driverId', 'forename', 'surname']],\n",
        "        on='driverId',\n",
        "        how='left'\n",
        "    )\n",
        "    driver_race_performance_year['surname_short'] = driver_race_performance_year['surname'].apply(lambda x: x[:3])\n",
        "\n",
        "    return driver_race_performance_year"
      ],

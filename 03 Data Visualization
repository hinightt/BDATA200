          "base_uri": "https://localhost:8080/",
          "height": 459
        }
      },
      "source": [
        "heart_age_fbs = heart.copy()\n",
        "heart_age_fbs['AgeBin'] = pd.cut(heart_age_fbs['age'], bins=range(20, 85, 5)) # Create age bins\n",
        "\n",
        "# Group by AgeBin and fbs, then calculate the mean of target (proportion of heart disease)\n",
        "heart_disease_prop_age_fbs = (heart_age_fbs.groupby(['AgeBin', 'fbs'], observed=True)['target']\n",
        "                                 .mean() * 100).unstack()\n",
        "\n",
        "midpoints = [interval.mid for interval in heart_disease_prop_age_fbs.index]\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 6), sharey=True) # 1 row, 2 columns for fbs categories, sharey=True for consistent scale\n",
        "\n",
        "fbs_labels = {0: 'FBS <= 120 mg/dl', 1: 'FBS > 120 mg/dl'}\n",
        "colors_for_fbs = ['#4B2E83', '#E8B923']\n",
        "\n",
        "for idx, (fbs_val, color) in enumerate(zip([0, 1], colors_for_fbs)):\n",
        "    if fbs_val in heart_disease_prop_age_fbs.columns:\n",
        "        subset = heart_disease_prop_age_fbs[fbs_val].dropna()\n",
        "        mids_subset = [interval.mid for interval in subset.index]\n",
        "\n",
        "        axes[idx].plot(mids_subset, subset.values, marker='o', linewidth=2.5,\n",
        "                       markersize=7, color=color)\n",
        "        axes[idx].fill_between(mids_subset, subset.values, alpha=0.15, color=color)\n",
        "        axes[idx].set_title(fbs_labels[fbs_val], fontsize=14, fontweight='bold', color=color)\n",
        "        axes[idx].set_xlabel('Age (midpoint of 5-year bin)', fontsize=12)\n",
        "        axes[idx].set_ylabel('Heart Disease Proportion (%)' if idx == 0 else '', fontsize=12)\n",
        "        axes[idx].grid(True, alpha=0.3)\n",
        "    else:\n",
        "        axes[idx].set_title(fbs_labels[fbs_val] + ' (No Data)', fontsize=14, fontweight='bold', color=color)\n",
        "        axes[idx].set_xlabel('Age (midpoint of 5-year bin)', fontsize=12)\n",
        "        axes[idx].set_ylabel('Heart Disease Proportion (%)' if idx == 0 else '', fontsize=12)\n",
        "        axes[idx].text(0.5, 0.5, 'No data for this FBS type', horizontalalignment='center', verticalalignment='center', transform=axes[idx].transAxes, fontsize=12, color='gray')\n",

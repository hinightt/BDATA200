        "means = grouped.mean() * 100\n",
        "# Standard error of a proportion: sqrt(p*(1-p)/n)\n",
        "se = grouped.apply(lambda x: np.sqrt(x.mean()*(1-x.mean())/len(x))) * 100\n",
        "ci95 = 1.96 * se\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "bars = ax.bar(means.index.astype(str), means.values,\n",
        "              yerr=ci95.values, capsize=8, color=['#4B2E83', '#E8B923', '#85714D'],\n",
        "              edgecolor='white', linewidth=1.5, error_kw={'linewidth': 2, 'color': '#333'})\n",
        "\n",
        "for bar, m in zip(bars, means.values):\n",
        "    ax.text(bar.get_x() + bar.get_width()/2., bar.get_height() + ci95.max() + 1,\n",

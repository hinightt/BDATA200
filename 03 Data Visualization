        "outputId": "ed78f9e3-bc50-4262-cf32-c301d3a4b0a8"
      },
      "source": [
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "\n",
        "positions = []\n",
        "group_data = []\n",
        "colors_box = []\n",
        "tick_labels = []\n",
        "pos = 1\n",
        "for cls in [1, 2, 3]:\n",
        "    for sex, color in [('female', '#4B2E83'), ('male', '#E8B923')]:\n",
        "        subset = titanic[(titanic['Pclass'] == cls) & (titanic['Sex'] == sex)]['Age'].dropna()\n",
        "        group_data.append(subset)\n",
        "        positions.append(pos)\n",
        "        colors_box.append(color)\n",
        "        tick_labels.append(f'Class {cls}\\n{sex.title()}')\n",
        "        pos += 1\n",
        "    pos += 0.5  # gap between classes\n",
        "\n",
        "bp = ax.boxplot(group_data, positions=positions, patch_artist=True, widths=0.6,\n",
        "                medianprops=dict(color='#C62828', linewidth=2))\n",
        "\n",
        "for patch, color in zip(bp['boxes'], colors_box):\n",
        "    patch.set_facecolor(color)\n",
        "    patch.set_alpha(0.7)\n",
        "\n",
        "ax.set_xticks(positions)\n",
        "ax.set_xticklabels(tick_labels, fontsize=9)\n",
        "ax.set_title('Age Distribution by Class & Sex', fontsize=16, fontweight='bold', color='#4B2E83')\n",
        "ax.set_xlabel('Group', fontsize=13)\n",
        "ax.set_ylabel('Age (years)', fontsize=13)\n",
        "ax.grid(True, axis='y', alpha=0.3)\n",
        "\n",
        "# Custom legend\n",
        "from matplotlib.patches import Patch\n",
        "ax.legend(handles=[Patch(facecolor='#4B2E83', alpha=0.7, label='Female'),\n",
        "                   Patch(facecolor='#E8B923', alpha=0.7, label='Male')],\n",
        "          frameon=True, fancybox=True, shadow=True, fontsize=11)\n",
        "\n",
        "fig.text(0.1, -0.02, 'Source: Titanic dataset — Kaggle',\n",
